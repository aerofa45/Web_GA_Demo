## Illustrative Cascade Velocity Format; not executed by the React app.
## Requires a program Data Definition with title, intro, and repeated feature/title fields.
## Bind an XML Index Block whose output contains /system-index-block/system-page.
#set($page = $_XPathTool.selectSingleNode($contentRoot, '/system-index-block/system-page'))
#if($page)
  #set($data = $page.getChild('system-data-structure'))
  #if($data)
    <section class="program">
      <h1>$_EscapeTool.xml($data.getChildText('title'))</h1>
      <p>$_EscapeTool.xml($data.getChildText('intro'))</p>
      <ul>
      #foreach($feature in $data.getChildren('feature'))
        <li>$_EscapeTool.xml($feature.getChildText('title'))</li>
      #end
      </ul>
    </section>
  #end
#end
